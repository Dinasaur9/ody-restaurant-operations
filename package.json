{
  "name": "ody-restaurant-operations",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:dashboard": "pnpm --filter @ody/dashboard dev",
    "dev:backend": "pnpm --filter @ody/backend dev",
    "gen:contract": "pnpm --filter @ody/backend openapi && pnpm --filter @ody/api-client generate",
    "db:generate": "pnpm --filter @ody/backend db:generate",
    "db:migrate": "pnpm --filter @ody/backend db:migrate",
    "db:seed": "pnpm --filter @ody/backend db:seed",
    "db:setup": "docker compose up -d postgres && pnpm db:migrate && pnpm db:seed",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
