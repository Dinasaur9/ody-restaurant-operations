{
  "openapi": "3.1.0",
  "info": {
    "title": "Ody Restaurant Operations API",
    "version": "0.1.0",
    "description": "Typed API for restaurant menu, orders, customers, and ordering settings."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service health and metadata"
    },
    {
      "name": "Menu",
      "description": "Menu categories and items"
    },
    {
      "name": "Orders",
      "description": "Ordering and kitchen workflow"
    },
    {
      "name": "CRM",
      "description": "Customer activity and value"
    },
    {
      "name": "Settings",
      "description": "Ordering configuration"
    },
    {
      "name": "Dashboard",
      "description": "Restaurant performance summaries"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "ody-restaurant-api"
            ]
          },
          "version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp"
        ]
      },
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "position",
          "isActive",
          "createdAt",
          "updatedAt",
          "items"
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "categoryId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "prepMinutes": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isAvailable": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "price",
          "prepMinutes",
          "isAvailable",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreatedMenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "position",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "The request could not be processed."
              },
              "requestId": {
                "type": "string",
                "example": "3c8d253b-c4fc-43d9-9893-d66cdcca87dc"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateMenuCategory": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 300
          },
          "position": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 1000000
          },
          "prepMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "categoryId",
          "name",
          "description",
          "price",
          "prepMinutes"
        ]
      },
      "UpdateMenuItem": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 1000000
          },
          "prepMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "price",
          "prepMinutes"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "displayId": {
            "type": "string"
          },
          "customerId": {
            "type": "integer",
            "nullable": true,
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "customerName": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "delivery",
              "pickup",
              "dine_in"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "subtotal": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "serviceFee": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "total": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "availableActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            }
          }
        },
        "required": [
          "id",
          "displayId",
          "customerId",
          "customerName",
          "channel",
          "status",
          "subtotal",
          "serviceFee",
          "total",
          "note",
          "createdAt",
          "updatedAt",
          "items",
          "availableActions"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "orderId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "menuItemId": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "unitPrice": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "total": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "required": [
          "id",
          "orderId",
          "menuItemId",
          "name",
          "unitPrice",
          "quantity",
          "total"
        ]
      },
      "UpdateOrderStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "customerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "channel": {
            "type": "string",
            "enum": [
              "delivery",
              "pickup",
              "dine_in"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "menuItemId": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25
                }
              },
              "required": [
                "menuItemId",
                "quantity"
              ]
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "customerName",
          "channel",
          "items"
        ]
      },
      "CustomerWithHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "orderCount": {
            "type": "integer",
            "minimum": 0
          },
          "totalSpend": {
            "type": "integer",
            "minimum": 0
          },
          "averageOrder": {
            "type": "integer",
            "minimum": 0
          },
          "lastOrderAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderPreview"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "createdAt",
          "updatedAt",
          "orderCount",
          "totalSpend",
          "averageOrder",
          "lastOrderAt",
          "recentOrders"
        ]
      },
      "OrderPreview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "displayId": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "delivery",
              "pickup",
              "dine_in"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "total": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "displayId",
          "customerName",
          "channel",
          "status",
          "total",
          "createdAt"
        ]
      },
      "OrderingSettings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "restaurantName": {
            "type": "string"
          },
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceEnabled": {
            "type": "boolean"
          },
          "openingTime": {
            "type": "string"
          },
          "closingTime": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "restaurantName",
          "prepTimeMinutes",
          "autoAcceptOrders",
          "serviceEnabled",
          "openingTime",
          "closingTime",
          "updatedAt"
        ]
      },
      "UpdateOrderingSettings": {
        "type": "object",
        "properties": {
          "restaurantName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "prepTimeMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceEnabled": {
            "type": "boolean"
          },
          "openingTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "closingTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "required": [
          "restaurantName",
          "prepTimeMinutes",
          "openingTime",
          "closingTime"
        ]
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "revenue": {
            "type": "integer",
            "minimum": 0
          },
          "totalOrders": {
            "type": "integer",
            "minimum": 0
          },
          "activeOrders": {
            "type": "integer",
            "minimum": 0
          },
          "pendingOrders": {
            "type": "integer",
            "minimum": 0
          },
          "averageOrder": {
            "type": "integer",
            "minimum": 0
          },
          "customers": {
            "type": "integer",
            "minimum": 0
          },
          "popularItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0
                },
                "revenue": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "quantity",
                "revenue"
              ]
            }
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderPreview"
            }
          }
        },
        "required": [
          "revenue",
          "totalOrders",
          "activeOrders",
          "pendingOrders",
          "averageOrder",
          "customers",
          "popularItems",
          "recentOrders"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API health",
        "description": "Returns service health without querying the database.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/menu": {
      "get": {
        "operationId": "getMenu",
        "summary": "List the categorized menu",
        "tags": [
          "Menu"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuCategory"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/menu/categories": {
      "post": {
        "operationId": "createMenuCategory",
        "summary": "Create a menu category",
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuCategory"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedMenuCategory"
                }
              }
            }
          },
          "422": {
            "description": "Invalid category data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/menu/items": {
      "post": {
        "operationId": "createMenuItem",
        "summary": "Create a menu item",
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Menu item created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid menu item data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/menu/items/{id}": {
      "patch": {
        "operationId": "updateMenuItem",
        "summary": "Update a menu item",
        "description": "Updates menu details or availability. This is the deliberate stock-control action used by the dashboard.",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "example": 3
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Menu item or category not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid menu item data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "getOrders",
        "summary": "List and filter orders",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "delivery",
                "pickup",
                "dine_in"
              ]
            },
            "required": false,
            "name": "channel",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": false,
            "name": "search",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid filters",
            "content": {
              "application/json": {
